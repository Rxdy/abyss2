{
  "name": "abyss2-api",
  "version": "1.0.0",
  "description": "Fastify API for Abyss2 — Prisma ORM",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "npx prisma migrate deploy && npx prisma generate && tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:deploy": "npx prisma migrate deploy",
    "db:studio": "npx prisma studio",
    "db:seed": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/csrf-protection": "^8.0.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/client": "^5.10.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.8.4",
    "nodemailer": "^10.0.10",
    "pino-pretty": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^6.4.17",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prisma": "^5.10.2",
    "tsx": "^4.13.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "5.0.1"
  }
}
