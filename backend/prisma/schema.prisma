// Prisma schema — Abyss2
// Source de vérité pour la base de données
// Schéma PostgreSQL: dbo

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["dbo"]
}

// ============================================================
// Model: User
// ============================================================
model User {
  id             String   @id @default(uuid()) @db.Uuid
  emailHash      String   @unique @map("email_hash") @db.VarChar(64)  // HMAC-SHA256 — blind index pour lookup
  emailEncrypted String   @map("email_encrypted") @db.Text            // AES-256-GCM — pour affichage
  passwordHash   String   @map("password_hash") @db.Text
  tokenVersion   Int      @default(0) @map("token_version")          // incrémenté → invalide tous les JWT déjà émis
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  categories     Category[]
  envelopes      Envelope[]
  transactions   Transaction[]
  recurring      RecurringTransaction[]
  resetTokens    PasswordResetToken[]
  notifications  Notification[]

  @@map("users")
  @@schema("dbo")
}

// ============================================================
// Model: PasswordResetToken — lien de réinitialisation envoyé par email
//
// Le jeton lui-même (haute entropie, 32 octets aléatoires) ne quitte jamais
// le serveur : seul son hash SHA-256 est stocké, comme un mot de passe.
// Une ligne par demande (pas de colonne sur User) : plusieurs demandes
// successives coexistent, et `usedAt` empêche de rejouer un lien déjà utilisé
// sans avoir à le supprimer (traçabilité).
// ============================================================
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  usedAt    DateTime? @map("used_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
  @@schema("dbo")
}

// ============================================================
// Model: Category — libellé chiffré, couleur en clair (affichage)
//
// Sous-catégories : une seule profondeur (parentId → catégorie de premier
// niveau uniquement). Si la catégorie parente est supprimée, ses enfants
// sont conservés et simplement promus en catégories de premier niveau
// (parentId → NULL) : on ne perd jamais de structure silencieusement.
// ============================================================
model Category {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  parentId      String?  @map("parent_id") @db.Uuid
  nameEncrypted String   @map("name_encrypted") @db.Text
  color         String?  @db.VarChar(7)   // #RRGGBB — non chiffré, sert au rendu
  position      Int?     @db.Integer
  budgetEncrypted String? @map("budget_encrypted") @db.Text  // plafond mensuel en centimes, chiffré — NULL : pas de budget
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  envelopeId    String?  @map("envelope_id") @db.Uuid

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        Category?     @relation("CategorySubcategories", fields: [parentId], references: [id], onDelete: SetNull)
  children      Category[]    @relation("CategorySubcategories")
  envelope      Envelope?     @relation(fields: [envelopeId], references: [id], onDelete: SetNull)
  transactions  Transaction[]
  recurring     RecurringTransaction[]

  @@index([userId])
  @@index([parentId])
  @@index([envelopeId])
  @@map("categories")
  @@schema("dbo")
}

// ============================================================
// Model: Envelope — enveloppe budgétaire mensuelle, alimentée par les
// revenus du mois, regroupant plusieurs catégories de dépense.
//
// Le montant alloué est un plafond informatif, jamais bloquant : dépasser
// une enveloppe ou allouer plus que les revenus du mois du côté du client
// n'empêche aucune transaction (voir todo.md). Si l'enveloppe est
// supprimée, ses catégories sont conservées et simplement détachées
// (envelope_id → NULL), comme une catégorie parente supprimée.
// ============================================================
model Envelope {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  nameEncrypted   String   @map("name_encrypted") @db.Text
  budgetEncrypted String   @map("budget_encrypted") @db.Text  // montant alloué par mois, en centimes, chiffré
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories      Category[]
  notifications   Notification[]

  @@index([userId])
  @@map("envelopes")
  @@schema("dbo")
}

// ============================================================
// Model: Transaction — libellé et montant chiffrés (AES-256-GCM)
// Le montant est stocké en centimes, sérialisé puis chiffré.
// ============================================================
model Transaction {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  categoryId      String?  @map("category_id") @db.Uuid
  recurringId     String?  @map("recurring_id") @db.Uuid  // renseigné si générée depuis une charge fixe
  titleEncrypted  String   @map("title_encrypted") @db.Text
  amountEncrypted String   @map("amount_encrypted") @db.Text
  date            DateTime @db.Date
  type            String   @default("expense") @db.VarChar(20)  // 'expense' | 'income'
  note            String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurring       RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, date])
  @@index([categoryId])
  @@index([recurringId])
  @@unique([recurringId, date], map: "uq_transactions_recurring_date")
  @@map("transactions")
  @@schema("dbo")
}

// ============================================================
// Model: RecurringTransaction — dépense ou revenu fixe mensuel
//
// Un job de rattrapage (voir utils/recurring.ts) génère une Transaction
// normale pour chaque mois écoulé depuis `lastGeneratedMonth` jusqu'au mois
// courant (dès que `dayOfMonth` est passé). Les transactions déjà générées
// restent des transactions indépendantes : modifier ou supprimer le modèle
// récurrent ne change jamais l'historique déjà généré.
// ============================================================
model RecurringTransaction {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  categoryId         String?   @map("category_id") @db.Uuid
  titleEncrypted     String    @map("title_encrypted") @db.Text
  amountEncrypted    String    @map("amount_encrypted") @db.Text
  type               String    @default("expense") @db.VarChar(20)  // 'expense' | 'income'
  dayOfMonth         Int       @map("day_of_month") @db.Integer     // 1-31, ramené au dernier jour du mois si besoin
  note               String?   @db.Text
  active             Boolean   @default(true)
  startDate          DateTime  @map("start_date") @db.Date
  endDate            DateTime? @map("end_date") @db.Date
  lastGeneratedMonth String?   @map("last_generated_month") @db.VarChar(7)  // 'YYYY-MM'
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category           Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions       Transaction[]

  @@index([userId])
  @@map("recurring_transactions")
  @@schema("dbo")
}

// ============================================================
// Model: Notification — enveloppe dépassée, dépenses non catégorisées…
//
// Pas de titre/message stocké : construits à la lecture à partir de `type`
// (+ `envelopeId`/`count`), comme les libellés d'erreur de l'API — rien de
// texte libre à chiffrer ici. Si l'enveloppe est supprimée, la notification
// est conservée (envelope_id → NULL) mais devient générique.
// ============================================================
model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       String    @db.VarChar(30)  // 'envelope_overspend' | 'uncategorized_digest'
  envelopeId String?   @map("envelope_id") @db.Uuid
  count      Int?                        // nombre de transactions concernées (digest)
  read       Boolean   @default(false)
  archived   Boolean   @default(false)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  envelope   Envelope? @relation(fields: [envelopeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, read])
  @@map("notifications")
  @@schema("dbo")
}
