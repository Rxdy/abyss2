# Database Configuration
DB_USER=abyss2_user
DB_PASSWORD=your_secure_password_here
DB_NAME=abyss2_db
DB_PORT=5434

# Prisma — DATABASE_URL (adapter selon les variables ci-dessus)
DATABASE_URL="postgresql://abyss2_user:your_secure_password_here@localhost:5434/abyss2_db?schema=dbo"

# API
FRONTEND_URL=http://localhost:5174

# JWT — Clé secrète pour signer les tokens (256 bits recommandé)
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_256bit_hex_here

# Chiffrement — clé principale 256 bits (blind index + AES-256-GCM)
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_SECRET=your_256bit_hex_secret_here

# SMTP — envoi des emails de récupération de mot de passe. Non défini en développement : l'API
# se rabat sur Mailpit (voir docker-compose.yml). Les définir, même en développement, envoie de
# vrais emails à la place de Mailpit — utile pour tester la réception réelle.
# Gmail : activer la validation en deux étapes puis générer un mot de passe d'application
# (myaccount.google.com/apppasswords) — jamais le mot de passe du compte. Retirer les espaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_address@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=Abyss2 <your_address@gmail.com>

# ── Production (make up-prod) — voir docker-compose.prod.yml ──────────────
# Domaine public, déjà pointé vers ce serveur.
DOMAIN=abyss2.example.com
# Réseau Docker externe sur lequel Traefik écoute déjà.
TRAEFIK_NETWORK=traefik
# Nom du point d'entrée HTTPS et du résolveur de certificats configurés côté Traefik.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

